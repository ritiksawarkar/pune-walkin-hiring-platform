# =============================================================================
# Pune Walk-In Drive & Hiring Management Platform
# Environment Configuration Template (.env.example)
# =============================================================================

# Server Port
PORT=8080

# Database Configuration (MySQL 8.x)
DB_URL=jdbc:mysql://localhost:3306/pune_walkin_hub?createDatabaseIfNotExist=true&serverTimezone=Asia/Kolkata&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Security
# Generate a secure 256-bit hexadecimal or Base64 secret in production
JWT_SECRET=4c92a94f6f890b5a3712b3e8c973a25b18f04e76a1d8c2e9b05f3a74c6d81e92
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

# File Upload Directory
UPLOAD_DIR=./uploads

# =============================================================================
# Production Email Service Configuration (SMTP)
# =============================================================================
# Set to 'true' in production when real SMTP credentials are provided.
# If 'false', interview confirmation emails are safely simulated locally without failing.
MAIL_ENABLED=false

# SMTP Server Host (e.g., smtp.gmail.com, smtp.sendgrid.net, email-smtp.us-east-1.amazonaws.com)
MAIL_HOST=smtp.gmail.com

# SMTP Server Port (587 for STARTTLS, 465 for SSL, 25)
MAIL_PORT=587

# SMTP Account Username / API Key
MAIL_USERNAME=your_smtp_username_or_email@gmail.com

# SMTP Account Password / App-specific Password / API Secret
MAIL_PASSWORD=your_smtp_app_password_here

# Verified Sender Email Address
MAIL_FROM=noreply@punewalkin.com
